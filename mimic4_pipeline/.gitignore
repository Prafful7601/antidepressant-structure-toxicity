# Data and derived artifacts are never committed. This repo ships code only;
# the MIMIC-IV demo (ODbL) and any future full MIMIC-IV data (PhysioNet DUA)
# must be re-downloaded/rebuilt locally by anyone reproducing this pipeline.
# The directory ignores (data/, output/, external/) are the main defense --
# everywhere those files actually live -- but the extension patterns are
# kept broad and unanchored (no leading "/") so they also catch a stray
# data file anywhere else in the tree, not just in those directories.
data/
output/
external/
*.duckdb
*.duckdb.wal
*.db
*.db.wal
*.csv
*.csv.gz
*.parquet

__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
